{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts",
    "./trpc": "./src/trpc.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "lol-sync:latest": "tsx src/jobs/run-lol-latest-match-sync.ts",
    "faceit-sync:latest": "tsx src/jobs/run-faceit-latest-match-sync.ts",
    "match-sync:latest": "tsx src/jobs/run-lol-latest-match-sync.ts && tsx src/jobs/run-faceit-latest-match-sync.ts"
  },
  "dependencies": {
    "@trpc/server": "^11.12.0",
    "zod": "^4.3.6",
    "superjson": "^2.2.6",
    "@repo/db": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/env": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
