{
  "expo": {
    "name": "Rnkd",
    "slug": "rnkd",
    "orientation": "portrait",
    "icon": "./assets/rnkd.png",
    "userInterfaceStyle": "dark",
    "scheme": "rnkd",
    "splash": {
      "image": "./assets/rnkd.png",
      "resizeMode": "contain",
      "backgroundColor": "#131013"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rnkd.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Rnkd needs access to your photo library so you can choose a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rnkd.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rnkd needs access to your photos so you can choose a profile picture."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "967fbb12-b65e-423a-a314-43f6554a9023"
      }
    },
    "owner": "kpr23"
  }
}
